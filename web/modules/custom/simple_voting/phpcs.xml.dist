<?xml version="1.0"?>
<ruleset name="Simple Voting">
  <description>Drupal and DrupalPractice coding standards for the Simple Voting module.</description>
  <arg name="extensions" value="php,module,install,inc"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <file>.</file>
  <exclude-pattern>*/docs/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>

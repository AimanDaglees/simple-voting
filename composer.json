{
  "name": "custom/simple-voting",
  "description": "Drupal 11 project for the Simple Voting module.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-project-message": "^11",
    "drupal/core-recommended": "^11",
    "drush/drush": "^13"
  },
  "require-dev": {
    "drupal/core-dev": "^11"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "php-http/discovery": true,
      "symfony/runtime": true,
      "phpstan/extension-installer": true,
      "tbachert/spi": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "check:phpcs": "phpcs --standard=web/modules/custom/simple_voting/phpcs.xml.dist web/modules/custom/simple_voting",
    "check:phpstan": "phpstan analyse -c web/modules/custom/simple_voting/phpstan.neon.dist --memory-limit=1G",
    "test:module": "phpunit -c web/core/phpunit.xml.dist web/modules/custom/simple_voting/tests/src"
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      }
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ]
    }
  }
}
